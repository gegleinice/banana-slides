{
	"name": "banana-slides",
	"version": "0.3.0",
	"description": "AI-powered PPT generation application (Profy edition)",
	"private": true,
	"scripts": {
		"dev": "npx -y @profy-ai/market-cli app dev",
		"dev:next": "next dev --port 81",
		"dev:backend": "cd backend && uv run python app.py",
		"dev:legacy-frontend": "cd legacy/frontend && npm run dev",
		"dev:docker": "docker compose up",
		"build": "next build",
		"start": "next start --port 81",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:backend": "uv run flake8 backend/ --count --select=E9,F63,F7,F82 --show-source --statistics",
		"profy:validate": "npx -y @profy-ai/market-cli app validate",
		"profy:deploy": "npx -y @profy-ai/market-cli app deploy",
		"profy:publish": "npx -y @profy-ai/market-cli app publish",
		"profy:status": "npx -y @profy-ai/market-cli app status",
		"profy:register": "npx -y @profy-ai/market-cli register",
		"setup:test": "uv sync --extra test && cd legacy/frontend && npm install",
		"setup:hooks": "chmod +x scripts/setup_git_hooks.sh && ./scripts/setup_git_hooks.sh",
		"test": "npm run test:backend && npm run test:frontend",
		"test:backend": "uv run pytest backend/tests/ -v",
		"test:frontend": "cd legacy/frontend && npm test -- --run",
		"test:e2e": "cd legacy/frontend && npm run test:e2e",
		"test:e2e:ui": "cd legacy/frontend && npm run test:e2e:ui",
		"test:docker": "chmod +x scripts/test_docker_environment.sh && ./scripts/test_docker_environment.sh",
		"test:all": "npm run test && npm run test:docker && npm run test:e2e",
		"quick-check": "npm run lint:backend && npm run test:backend",
		"docker:build": "docker compose build",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"axios": "^1.15.1",
		"clsx": "^2.1.1",
		"i18next": "^26.0.6",
		"i18next-browser-languagedetector": "^8.2.1",
		"katex": "^0.16.45",
		"lucide-react": "^1.8.0",
		"next": "^16.2.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-i18next": "^17.0.4",
		"react-markdown": "^10.1.0",
		"rehype-katex": "^7.0.1",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"tailwind-merge": "^3.5.0",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.7",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
